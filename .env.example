# ===========================================
# ProGear Sales AI - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# -------------------------------------------
# LLM Configuration (Claude on Amazon Bedrock)
# -------------------------------------------
# Bedrock inference profile ID. Default is Claude Opus 5.5 via the US geo profile.
# Other verified options: global.anthropic.claude-opus-5-5, eu.anthropic.claude-opus-5-5,
# us.anthropic.claude-sonnet-5-5 (cheaper). Enable the model under Bedrock > Model access.
# (The old claude-sonnet-4-20250514 model reaches end of life on Bedrock on 2026-10-14.)
BEDROCK_MODEL_ID=us.anthropic.claude-opus-5-5
# An inference-profile ARN (arn:aws:bedrock:...:inference-profile/...) also works;
# the provider is inferred from it, or set BEDROCK_MODEL_PROVIDER=anthropic explicitly.
AWS_REGION=us-east-1

# Credentials - boto3 default chain. On Render/Azure/EC2 set static keys or use an
# attached IAM role. Locally you can use a named profile instead (AWS_PROFILE=...).
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AWS_SESSION_TOKEN=            # only for temporary credentials
# AWS_PROFILE=default           # alternative to static keys for local dev
# BEDROCK_ENDPOINT_URL=         # optional VPC endpoint for Bedrock runtime

# -------------------------------------------
# Okta Configuration (AI Agent Governance)
# -------------------------------------------
# Your Okta domain
OKTA_DOMAIN=https://qa-aiagentsproducttc1.trexcloud.com

# Sales Agent App (OAuth/OIDC client linked to AI Agent)
OKTA_CLIENT_ID=0oa8x5nsjp8aDUpB70g7

# Sales Agent identity in AI Agent Directory
OKTA_AI_AGENT_ID=wlp8x5q7mvH86KvFJ0g7

# Sales Agent's JWK private key (JSON string - from agent registration)
# This is used for JWT Bearer authentication (no client secret needed)
OKTA_AI_AGENT_PRIVATE_KEY={"kty":"RSA","kid":"xxx","alg":"RS256","n":"...","e":"...","d":"...","p":"...","q":"...","dp":"...","dq":"...","qi":"..."}

# -------------------------------------------
# Authorization Servers
# -------------------------------------------
# MCP API Auth Server (for agent access to resources)
OKTA_MCP_AUTH_SERVER_ID=aus8x7lzid61nnRv70g7
OKTA_MCP_AUDIENCE=api://progear-mcp

# Main API Auth Server (for user authentication)
OKTA_MAIN_AUTH_SERVER_ID=aus8x7md5e7ObXMAH0g7
OKTA_MAIN_AUDIENCE=api://progear-main

# -------------------------------------------
# Auth0 Configuration (FUTURE - for Token Vault, FGA)
# -------------------------------------------
# AUTH0_DOMAIN=your-tenant.auth0.com
# AUTH0_CLIENT_ID=xxxxxxxxxxxxxxx
# AUTH0_CLIENT_SECRET=xxxxxxxxxxxxxxx

# Auth0 FGA (Fine-Grained Authorization)
# FGA_STORE_ID=xxxxxxxxxxxxxxx
# FGA_CLIENT_ID=xxxxxxxxxxxxxxx
# FGA_CLIENT_SECRET=xxxxxxxxxxxxxxx
# FGA_API_URL=https://api.us1.fga.dev

# -------------------------------------------
# Frontend Configuration (Next.js - localhost or Azure App Service)
# -------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-random-secret-here

# Public vars (exposed to browser)
NEXT_PUBLIC_OKTA_CLIENT_ID=0oa8x5nsjp8aDUpB70g7
NEXT_PUBLIC_OKTA_DOMAIN=https://qa-aiagentsproducttc1.trexcloud.com
NEXT_PUBLIC_OKTA_ISSUER=https://qa-aiagentsproducttc1.trexcloud.com/oauth2/aus8x7md5e7ObXMAH0g7
NEXT_PUBLIC_API_URL=http://localhost:8000

# -------------------------------------------
# Backend Configuration (FastAPI on Render)
# -------------------------------------------
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# -------------------------------------------
# MCP Server Configuration (on Render)
# -------------------------------------------
MCP_SERVER_URL=http://localhost:3001
MCP_SERVER_PORT=3001

# -------------------------------------------
# Deployment URLs (update after deploying)
# -------------------------------------------
# NEXT_PUBLIC_API_URL=https://progear-backend.onrender.com
# MCP_SERVER_URL=https://progear-mcp.onrender.com
# NEXTAUTH_URL=https://your-app-name.azurewebsites.net
# CORS_ORIGINS=https://your-app-name.azurewebsites.net
