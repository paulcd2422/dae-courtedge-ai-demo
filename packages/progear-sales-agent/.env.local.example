# Frontend-only environment for `npm run dev` on localhost.
# Next.js reads .env.local from THIS directory (packages/progear-sales-agent),
# not from the repository root. Copy this file to .env.local and fill it in.

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-output-of-openssl-rand-base64-32

# Okta OIDC app used by NextAuth
NEXT_PUBLIC_OKTA_CLIENT_ID=0oaxxxxxxxxxxxxxxxxx
OKTA_CLIENT_SECRET=your-okta-client-secret
NEXT_PUBLIC_OKTA_DOMAIN=https://your-org.okta.com
# Org Authorization Server (no custom auth server ID)
NEXT_PUBLIC_OKTA_ISSUER=https://your-org.okta.com

# FastAPI backend (localhost, or your Azure/Render URL)
NEXT_PUBLIC_API_URL=http://localhost:8000
